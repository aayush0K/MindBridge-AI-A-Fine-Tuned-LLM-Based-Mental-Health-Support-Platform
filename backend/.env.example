# ── DATABASE ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5435/mindbridge

# ── AUTH (required) ───────────────────────────────────────────
# Generate a random secret key for production:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── MINDBRIDGE FINE-TUNED MODEL (Llama 3 + QLoRA) ─────────────
MINDBRIDGE_BASE_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
MINDBRIDGE_ADAPTER_ID=aayush0K/Llama-3-MindBridge
# Remote GPU Server URL (e.g., https://your-colab-ngrok-url.ngrok-free.app/generate or http://localhost:8001/generate)
INFERENCE_URL=http://localhost:8001/generate
# Optional: Set if your remote GPU server has API Key protection enabled
REMOTE_INFERENCE_API_KEY=

# ── REDIS (conversation memory) ───────────────────────────────
REDIS_URL=redis://localhost:6380

# ── APP ───────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
CORPUS_PATH=./corpus/mental_health_corpus.json
APP_ENV=development

# ── SEMANTIC RESPONSE CACHE ──────────────────────────────────
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.90
SEMANTIC_CACHE_TTL_DAYS=30
